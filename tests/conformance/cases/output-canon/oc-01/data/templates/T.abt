schema Slot {
    mode: text(1..40)
}

schema T {
    id: text(1..80)
    slots {
        1: $(Slot)
        2: $(Slot) @optional
    }
    switches {
        yes: text(1..20) @optional
        no: text(1..20) @optional
        on: text(1..20) @optional
        off: text(1..20) @optional
        null: text(1..20) @optional
        y: text(1..20) @optional
    }
}
