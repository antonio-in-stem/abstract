schema Thing {
    id: text(1..40)
    label: text(1..40)
    tags[]: text(1..20)
}

logic Thing {
    // outside the loop .id is the root id ("one")
    require .id == "one" else throw "OUTSIDE loop: .id is not one"
    for id in .tags {
        // inside the loop the segment "id" is replaced by the loop value "label",
        // so ".id" silently reads the root field ".label" instead
        require .id == "THE-LABEL-VALUE" else throw "INSIDE loop: .id is not THE-LABEL-VALUE"
        require .id != "one" else throw "INSIDE loop: .id still equals the root id"
    }
}
